#!/usr/bin/env python3
"""Read-only Git observations for explicitly supplied repository paths."""
import argparse
import json
import math
import os
import re
from pathlib import Path
import signal
import subprocess
import sys

VERSION = "0.1.0rc1"


class InspectionError(Exception):
    pass


def stop_query(process):
    """Reap a timed-out/interrupted query and its same-group helpers."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        process.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        # A helper that deliberately detached may still hold a pipe. Do not wait
        # forever for unrelated descendants; only our query group is owned here.
        for stream in (process.stdout, process.stderr):
            if stream:
                stream.close()
        process.wait(timeout=1)


class Git:
    def __init__(self, path, timeout):
        self.path = path
        self.timeout = timeout
        self.env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
        self.env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0",
                        GIT_NO_REPLACE_OBJECTS="1", GIT_NO_LAZY_FETCH="1",
                        GIT_ALLOW_PROTOCOL="", GIT_PROTOCOL_FROM_USER="0", LC_ALL="C")

    def run(self, *args, allowed=(0,)):
        process = None
        try:
            try:
                # A signal after fork but before assignment must not orphan the
                # query. Defer handled termination only until its handle is owned.
                pending = []
                handlers = {}
                def defer(number, frame):
                    if not pending:
                        pending.append(number)
                try:
                    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                        previous = signal.getsignal(number)
                        if previous != signal.SIG_IGN:
                            handlers[number] = previous
                            signal.signal(number, defer)
                    process = subprocess.Popen(
                        ["git", "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
                         "-c", "submodule.recurse=false", "-C", str(self.path), *args],
                        env=self.env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE, start_new_session=True)
                finally:
                    for number, previous in handlers.items():
                        signal.signal(number, previous)
                    if pending:
                        if pending[0] == signal.SIGINT:
                            raise KeyboardInterrupt
                        raise SystemExit(128 + pending[0])
                stdout, stderr = process.communicate(timeout=self.timeout)
            except subprocess.TimeoutExpired as exc:
                stop_query(process)
                raise InspectionError("git " + args[0] + " exceeded its query timeout") from exc
            except BaseException:
                if process is not None:
                    stop_query(process)
                raise
            result = subprocess.CompletedProcess(process.args, process.returncode, stdout, stderr)
        except OSError as exc:
            raise InspectionError("cannot execute git: " + str(exc)) from exc
        if result.returncode not in allowed:
            error = os.fsdecode(result.stderr).strip()
            raise InspectionError("git " + args[0] + " failed (" + str(result.returncode) + ")" +
                                  (": " + error if error else ""))
        if result.stderr.strip():
            raise InspectionError("git " + args[0] + " reported diagnostics: " + os.fsdecode(result.stderr).strip())
        return result

    def text(self, *args, allowed=(0,)):
        data = self.run(*args, allowed=allowed).stdout
        return os.fsdecode(data[:-1] if data.endswith(b"\n") else data)


def split_index_reason(git, seen=None):
    """Avoid index-reading commands that refresh shared-index timestamps.

    Residual shared-index artifacts are deliberately conservative blockers. Check
    initialized submodules too: parent status reads their indexes even when
    submodule.recurse is false. None of these queries downloads or initializes one.
    """
    if seen is None:
        seen = set()
    root = git.path.resolve()
    if root in seen:
        return None
    seen.add(root)
    configured = git.run("config", "--type=bool", "--get", "core.splitIndex", allowed=(0, 1))
    if configured.returncode == 0:
        if configured.stdout not in (b"true\n", b"false\n"):
            raise InspectionError("malformed core.splitIndex value")
        if configured.stdout == b"true\n":
            return "split index configured at " + str(root)
    index = Path(git.text("rev-parse", "--git-path", "index"))
    if not index.is_absolute():
        index = root / index
    try:
        with os.scandir(index.parent) as entries:
            if any(entry.name.startswith("sharedindex.") for entry in entries):
                return "split index artifacts present at " + str(index.parent)
    except OSError as exc:
        raise InspectionError("cannot inspect index directory: " + str(exc)) from exc
    # Reading this parent index is safe only after its split-index boundary check.
    entries = git.run("ls-files", "--stage", "-z").stdout
    if entries and not entries.endswith(b"\0"):
        raise InspectionError("unterminated Git index entries")
    for entry in entries.split(b"\0"):
        if not entry:
            continue
        header, tab, name = entry.partition(b"\t")
        fields = header.split(b" ")
        if not tab or len(fields) != 3 or not name:
            raise InspectionError("malformed Git index entry")
        if fields[0] != b"160000":
            continue
        child = root / os.fsdecode(name)
        marker = child / ".git"
        if not marker.exists() and not marker.is_symlink():
            continue
        child_git = Git(child, git.timeout)
        resolved = Path(child_git.text("rev-parse", "--show-toplevel")).resolve()
        if resolved != child.resolve():
            raise InspectionError("submodule does not resolve to its own working tree: " + str(child))
        child_git.path = resolved
        reason = split_index_reason(child_git, seen)
        if reason:
            return reason
    return None


def count_status(raw):
    counts = {"tracked": 0, "staged": 0, "unstaged": 0, "untracked": 0, "unmerged": 0}
    if raw and not raw.endswith(b"\0"):
        raise InspectionError("unterminated Git status output")
    records = raw.split(b"\0")[:-1] if raw else []
    index = 0
    while index < len(records):
        entry = records[index]
        index += 1
        if len(entry) < 4 or entry[2:3] != b" ":
            raise InspectionError("malformed Git status record")
        code = entry[:2]
        if code == b"??":
            counts["untracked"] += 1
            continue
        if code == b"  " or any(value not in b" MADRCUT" for value in code):
            raise InspectionError("unexpected Git status code")
        counts["tracked"] += 1
        counts["staged"] += int(code[0:1] != b" ")
        counts["unstaged"] += int(code[1:2] != b" ")
        counts["unmerged"] += int(code in (b"DD", b"AU", b"UD", b"UA", b"DU", b"AA", b"UU"))
        if b"R" in code or b"C" in code:
            if index >= len(records) or not records[index]:
                raise InspectionError("incomplete Git rename/copy record")
            index += 1
    return counts


def inspect(path, timeout):
    row = {"input": str(path), "path": None, "state": "unknown", "branch": None,
           "head": None, "cleanliness": "unknown", "counts": None,
           "upstream": None, "upstream_remote": None, "upstream_merge": None,
           "sync": "unknown", "ahead": None, "behind": None,
           "sync_reason": None, "warnings": [], "errors": []}
    try:
        directory = Path(path).resolve()
        if not directory.is_dir():
            raise InspectionError("input is not an accessible directory")
        git = Git(directory, timeout)
        version = re.match(r"^git version ([0-9]+)\.([0-9]+)(?:\.|$)", git.text("--version"))
        if version is None or tuple(map(int, version.groups())) < (2, 36):
            raise InspectionError("Git 2.36 or newer is required to disable fsmonitor safely")
        if git.text("rev-parse", "--is-inside-work-tree") != "true":
            raise InspectionError("a non-bare Git working tree is required")
        row["path"] = git.text("rev-parse", "--show-toplevel")
        git.path = Path(row["path"])
    except (InspectionError, OSError, ValueError, RuntimeError) as exc:
        row["errors"].append(str(exc))
        return row

    try:
        symbolic = git.run("symbolic-ref", "--quiet", "HEAD", allowed=(0, 1))
        if symbolic.returncode == 0:
            ref = os.fsdecode(symbolic.stdout[:-1] if symbolic.stdout.endswith(b"\n") else symbolic.stdout)
            if not ref.startswith("refs/heads/"):
                raise InspectionError("HEAD does not reference a local branch")
            row["branch"] = ref[len("refs/heads/"):]
            exists = git.run("show-ref", "--verify", "--quiet", ref, allowed=(0, 1))
            if exists.returncode == 1:
                row["state"] = "unborn"
            else:
                row["head"] = git.text("rev-parse", "--verify", "HEAD^{commit}")
                row["state"] = "branch"
        else:
            row["head"] = git.text("rev-parse", "--verify", "HEAD^{commit}")
            row["state"] = "detached"
    except InspectionError as exc:
        row["errors"].append(str(exc))

    try:
        split_reason = split_index_reason(git)
        if split_reason:
            row["warnings"].append(split_reason + "; working-tree queries skipped to avoid changing shared-index timestamps")
        else:
            raw = git.run("status", "--porcelain=v1", "-z", "--untracked-files=all",
                          "--ignore-submodules=none").stdout
            row["counts"] = count_status(raw)
            flags = git.run("ls-files", "-v", "-z").stdout
            if flags and not flags.endswith(b"\0"):
                raise InspectionError("unterminated Git index flag output")
            hidden = 0
            for entry in flags.split(b"\0"):
                if not entry:
                    continue
                if len(entry) < 3 or entry[1:2] != b" " or entry[:1] not in b"HSMRCK?hsmrck":
                    raise InspectionError("malformed Git index flag output")
                if entry[:1].islower() or entry[:1] == b"S":
                    hidden += 1
            if hidden:
                row["counts"] = None
                row["warnings"].append("assume-unchanged/skip-worktree flags conceal possible edits in " + str(hidden) + " entries")
            else:
                row["cleanliness"] = "dirty" if row["counts"]["tracked"] or row["counts"]["untracked"] else "clean"
    except (InspectionError, OSError, ValueError, RuntimeError) as exc:
        row["cleanliness"] = "unknown"
        row["counts"] = None
        row["errors"].append(str(exc))

    if row["state"] != "branch":
        row["sync_reason"] = "no committed attached branch"
        return row
    try:
        prefix = "branch." + row["branch"]
        remote = git.run("config", "--get", prefix + ".remote", allowed=(0, 1))
        merge = git.run("config", "--null", "--get-all", prefix + ".merge", allowed=(0, 1))
        row["upstream_remote"] = os.fsdecode(remote.stdout[:-1]) if remote.returncode == 0 else None
        if merge.returncode == 0:
            if not merge.stdout or not merge.stdout.endswith(b"\0"):
                raise InspectionError("malformed Git upstream merge configuration")
            merges = merge.stdout.split(b"\0")[:-1]
            row["upstream_merge"] = os.fsdecode(merges[0])
            if len(merges) > 1:
                row["warnings"].append("multiple merge targets configured; comparison uses Git's first upstream")
        if remote.returncode == 1 or merge.returncode == 1:
            row["sync_reason"] = "no configured upstream"
            return row
        ref = "refs/heads/" + row["branch"]
        refs = git.text("for-each-ref", "--format=%(refname)%00%(upstream)", "--", ref)
        matching = [line.split("\0", 1) for line in refs.split("\n") if line.startswith(ref + "\0")]
        if len(matching) != 1:
            raise InspectionError("attached branch changed or disappeared during inspection")
        row["upstream"] = matching[0][1] or None
        if not row["upstream"]:
            row["sync_reason"] = "configured upstream is unavailable locally"
            return row
        if not row["upstream"].startswith("refs/"):
            raise InspectionError("Git returned an invalid upstream ref")
        exists = git.run("show-ref", "--verify", "--quiet", row["upstream"], allowed=(0, 1))
        if exists.returncode == 1:
            row["sync_reason"] = "configured upstream is unavailable locally"
            return row
        upstream_commit = git.text("rev-parse", "--verify", row["upstream"] + "^{commit}")
        shallow = git.text("rev-parse", "--is-shallow-repository")
        if shallow not in ("true", "false"):
            raise InspectionError("malformed Git shallow-repository state")
        if shallow == "true":
            row["warnings"].append("shallow history: ahead/behind counts cover available local history only")
        comparison = git.text("rev-list", "--left-right", "--count",
                              row["head"] + "..." + upstream_commit).split()
        if len(comparison) != 2 or any(not value.isascii() or not value.isdecimal() for value in comparison):
            raise InspectionError("malformed Git ahead/behind counts")
        row["ahead"], row["behind"] = map(int, comparison)
        if row["ahead"] and row["behind"]:
            row["sync"] = "diverged"
        elif row["ahead"]:
            row["sync"] = "ahead"
        elif row["behind"]:
            row["sync"] = "behind"
        else:
            row["sync"] = "equal"
        row["sync_reason"] = "local refs only; remote freshness is unknown"
    except InspectionError as exc:
        row["sync_reason"] = "upstream inspection failed"
        row["errors"].append(str(exc))
    return row


def cell(value):
    return json.dumps(str(value), ensure_ascii=True)[1:-1].replace("|", "\\u007c")


def render_table(rows):
    print("REPOSITORY | BRANCH/STATE | WORKTREE | TRACKED | STAGED | UNSTAGED | UNTRACKED | UNMERGED | UPSTREAM | SYNC | AHEAD | BEHIND")
    for row in rows:
        counts = row["counts"] or {}
        branch = row["branch"] if row["state"] == "branch" else row["state"].upper()
        values = [row["path"] or row["input"], branch, row["cleanliness"].upper(),
                  counts.get("tracked", "UNKNOWN"), counts.get("staged", "UNKNOWN"),
                  counts.get("unstaged", "UNKNOWN"), counts.get("untracked", "UNKNOWN"),
                  counts.get("unmerged", "UNKNOWN"), row["upstream"] or "UNKNOWN", row["sync"].upper(), row["ahead"] if row["ahead"] is not None else "UNKNOWN",
                  row["behind"] if row["behind"] is not None else "UNKNOWN"]
        print(" | ".join(cell(value) for value in values))
        for detail in row["errors"] + row["warnings"]:
            print("  ! " + cell(detail))
        if row["sync"] == "unknown" and row["sync_reason"]:
            print("  ! " + cell(row["sync_reason"]))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version="repo-health " + VERSION)
    parser.add_argument("--json", action="store_true", help="emit a JSON array instead of a table")
    parser.add_argument("--timeout", type=float, default=10, help="seconds per Git query (default 10)")
    parser.add_argument("paths", nargs="+", help="explicit working-tree roots or subdirectories; no discovery")
    args = parser.parse_args()
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        parser.error("--timeout must be finite and positive")
    rows = [inspect(path, args.timeout) for path in args.paths]
    if args.json:
        print(json.dumps(rows, sort_keys=True))
    else:
        render_table(rows)
    return 1 if any(row["errors"] for row in rows) else 0


if __name__ == "__main__":
    for handled_signal in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(handled_signal, lambda number, frame: sys.exit(128 + number))
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(1)
